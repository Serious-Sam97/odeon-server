# Onde estão suas mídias no HOST. Montado read-only em /media dentro do container.
# No Mac hoje: ~/Movies. Quando o DAS estiver montado: /Volumes/SEU_DAS/Filmes
# No ROG (CachyOS): /mnt/das/filmes
# A pasta RAIZ que o servidor enxerga. Dentro dela você cria as bibliotecas
# (Filmes, Séries, Anime…) pela própria interface — não precisa uma variável
# por biblioteca.
MEDIA_PATH=/Users/serioussam/Movies

# Discos adicionais, se houver mais de um. Deixe vazio se não usar.
#
# DAS em OUTRA MÁQUINA: monte o compartilhamento no host primeiro. No macOS,
# Finder → Ir → Conectar ao servidor → smb://IP-DO-PC/compartilhamento, e
# aponte pra /Volumes/NOME. Lembre que o vídeo vai trafegar PC → aqui → você;
# rodar o Odeon na máquina do DAS é sempre melhor.
MEDIA_PATH_2=
MEDIA_PATH_3=

POSTGRES_PASSWORD=odeon

# Identificação de filmes e séries. Pegue em https://www.themoviedb.org/settings/api
# (grátis, precisa de conta). Aceita a chave v3 (hex de 32) ou o token v4 (JWT).
# Sem ela o Odeon ainda identifica ANIME pelo AniList, que não pede chave.
TMDB_API_KEY=

# Portas no host (escolhidas pra não bater com o palco/outros projetos)
DB_PORT=5433
API_PORT=8080
WEB_PORT=5174

# CORS: localhost e o mesmo host da requisição (qualquer porta) já são aceitos
# sem configurar nada — cobre http://rog:5174 falando com http://rog:8080.
# Só preencha se o front vier de OUTRO nome. `*` libera tudo (não recomendado).
ODEON_ALLOWED_ORIGINS=

# HTTPS. Deixe vazio pra rodar só em HTTP.
#
# O caminho certo NÃO é certificado auto-assinado (cada aparelho precisaria
# confiar numa CA nova, e instalar CA em Android TV é um suplício). A Tailscale
# emite Let's Encrypt de verdade:
#
#   tailscale cert --cert-file certs/cert.crt --key-file certs/cert.key \
#       odeon.SEU-TAILNET.ts.net
#
# Depois preencha os dois caminhos abaixo (são de DENTRO do container):
ODEON_TLS_CERT=
ODEON_TLS_KEY=
HTTPS_PORT=8443
# true = a porta HTTP passa a só redirecionar pro HTTPS
ODEON_HTTPS_ONLY=false

RUST_LOG=odeon=debug,tower_http=info,info
